# This file is generated by the container entrypoint only when
# TEXLYRE_TYPESETTER_URL and TEXLYRE_TYPESETTER_PROXY_TOKEN are supplied.
location = /texlyre-typesetter {
	proxy_pass __TEXLYRE_TYPESETTER_URL__;
	proxy_http_version 1.1;
	proxy_set_header Upgrade $http_upgrade;
	proxy_set_header Connection "upgrade";
	proxy_set_header Host $proxy_host;
	proxy_set_header X-Real-IP $remote_addr;
	proxy_set_header X-TeXlyre-Typesetter-Token "__TEXLYRE_TYPESETTER_PROXY_TOKEN__";
	proxy_read_timeout 600s;
	proxy_send_timeout 600s;
	proxy_buffering off;
}
